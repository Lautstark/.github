// The Lautstark Renovate preset.
//
// ---------------------------------------------------------------------------
// HOW TO USE THIS
//
// It lived in vorlaut-editor until 2026-08-28, written to be liftable without
// an edit, and this is where it was going. A repository picks it up with one
// line:
//
//     { extends: ["github>Lautstark/.github//renovate-shared.json5"] }
//
// The .json5 is spelled out because the //path syntax implies .json. The
// shorter "owner/repo:name" form does the same, so it cannot be used for this
// file either - Renovate looks for a file that is not there and stops before
// it does anything.
//
// WHAT BELONGS HERE, AND WHAT DOES NOT
//
// Everything in this file is true of every Lautstark repository: when updates
// arrive, what groups with what, what may merge itself. Nothing here names a
// package.
//
// Anything about a *particular* dependency stays in the repository's own
// renovate.json5, and that is not tidiness: a repository that inherited such
// a rule from here would be silently opting out of updates to dependencies it
// does not have. onnxruntime-web, whose version is written in three files at
// once in the repositories that pin it, is the standing example.
//
// Two exceptions, both added 2026-09-16, and both true of every repository
// in the family rather than of one:
//
//   @lautstark/*   the shared packages, pinned as github: tags - and since
//                  2026-09-16 tagged from their main branches by CI rather
//                  than by hand. Until then the apps disabled Renovate for
//                  them, because "a bump of these is a decision, not an
//                  update" and because the npm manager was thought unable to
//                  follow a github: tag. It can: a `github:owner/repo#vX.Y.Z`
//                  pin resolves through the github-tags datasource, and
//                  Renovate rewrites the tag and the lockfile's commit the
//                  way it rewrites a range. What changed is where the
//                  decision is made. The package author makes it in the
//                  commit subject - feat is a minor, fix a patch, feat! a
//                  major - and the consumer's tests make it again on the
//                  branch Renovate pushes. A minor or a patch that passes
//                  them merges to main on its own; a major waits for a
//                  person, with the changelog in front of them. The rule is
//                  here because every app consumes these packages the same
//                  way; the one package a repository still keeps by hand
//                  (bildquelle, where what changes is what may leave a
//                  METACOM folder) is named in that repository's own file.
//
//   the toolchain  vite, vitest, typescript, playwright: grouped under one
//                  name in every repository, so that a week's bumps are one
//                  branch per repository with the same title, and a repository
//                  that has not taken them is visible on its dashboard as the
//                  one without that branch. @lautstark/toolchain is where
//                  those versions are meant to live once; until every app
//                  extends it, the group is what keeps them from drifting.
//
// HOW AUTOMERGE WORKS HERE, SINCE 2026-09-16
//
// automergeType "branch": Renovate pushes renovate/<name>, waits for the
// branch's status checks, and if they are green pushes that commit to main
// itself. No pull request is opened for a branch that merges, which is the
// shape this family lands everything in (trunk-based, no pull requests). The
// consequence for a repository is that its test workflow has to run on
// renovate/** branches, and its deploy job has to check github.ref rather
// than the event name - both are done in every repository's workflows. A
// branch with no status checks is never merged (ignoreTests stays false).
//
// platformAutomerge stays on for the one case Renovate falls back to a pull
// request - a branch that cannot be fast-forwarded - so that one merges on
// its own too, through GitHub's own merge queue rather than by rebasing
// outside the platform.
//
// NOT COVERED: Gradle, Kotlin, Android. The Android repository does not exist
// yet, and a preset written against a guess about its build is a preset that
// will be wrong when it arrives. Add a manager for it then, from the actual
// build files.
// ---------------------------------------------------------------------------
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  extends: [
    "config:recommended",

    // Conventional commits, with the split release-please wants: a runtime
    // dependency bump is "fix(deps):" and shows up in the changelog, a dev
    // one is "chore(deps):" and does not. Nobody reading a release note cares
    // which version of vitest built it.
    ":semanticPrefixFixDepsChoreOthers",

    // One issue listing everything waiting, rather than a wall of pull
    // requests. For a solo maintainer this is the difference between reading
    // them and muting them.
    ":dependencyDashboard",
  ],

  timezone: "Europe/Berlin",

  // Weekly. Monday before six, so a week's worth of updates is one thing to
  // look at on Monday morning rather than a trickle all week.
  schedule: ["before 6am on monday"],
  // lockFileMaintenance carries its own schedule and does not inherit.
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 6am on monday"],
  },

  // Three pull requests is a Monday. Thirty is a mute button.
  prConcurrentLimit: 3,
  prHourlyLimit: 0,

  // Renovate rebases only what has gone stale, rather than rewriting every
  // open branch every run.
  rebaseWhen: "conflicted",

  // Security fixes are the one thing that must not wait for Monday.
  osvVulnerabilityAlerts: true,
  vulnerabilityAlerts: {
    schedule: ["at any time"],
    minimumReleaseAge: null,
    labels: ["security"],
    // Never automerged, whatever it is. A security bump is exactly the moment
    // to look at the diff.
    automerge: false,
  },

  packageRules: [
    // ---------------------------------------------------------------------
    // Development dependencies: grouped, and the only thing that automerges
    // ---------------------------------------------------------------------
    {
      matchDepTypes: ["devDependencies"],
      matchUpdateTypes: ["patch", "minor"],
      groupName: "dev dependencies",
      commitMessageTopic: "the dev dependencies",
      automerge: true,
      // Straight to main once the branch is green - see the header. The
      // pull-request fallback merges on the platform too.
      automergeType: "branch",
      platformAutomerge: true,
      // Three days between a version being published and this merging it
      // unattended. Compromised packages are typically pulled within hours,
      // and nothing here is urgent enough to need a release the day it lands.
      minimumReleaseAge: "3 days",
      labels: ["dependencies", "automerge"],
    },

    // ---------------------------------------------------------------------
    // The toolchain: one group, one name, in every repository
    // ---------------------------------------------------------------------
    //
    // After the dev-dependency group so that it wins - a later rule overrides
    // an earlier one, and a toolchain bump is a dev-dependency bump too, which
    // the rule above would otherwise fold into "dev dependencies". Same
    // automerge policy as those - a minor or a patch
    // merges itself after three days on the registry, a major does not - but
    // under its own title, so that "vitest 4" arriving in six repositories is
    // six branches called the same thing.
    {
      matchPackageNames: [
        "vite",
        "vitest",
        "@vitest/**",
        "vite-node",
        "typescript",
        "@playwright/test",
        "playwright",
        "@lautstark/toolchain",
        "Lautstark/toolchain",
      ],
      matchUpdateTypes: ["patch", "minor"],
      groupName: "toolchain",
      commitMessageTopic: "the toolchain",
      automerge: true,
      automergeType: "branch",
      platformAutomerge: true,
      minimumReleaseAge: "3 days",
      labels: ["dependencies", "toolchain", "automerge"],
    },

    // ---------------------------------------------------------------------
    // The shared packages: a minor or a patch merges itself, a major waits
    // ---------------------------------------------------------------------
    //
    // github-tags is the datasource a `github:Lautstark/<pkg>#vX.Y.Z` pin
    // resolves through; the package name it carries is the repository,
    // `Lautstark/<pkg>`, and the pin string stays a pin - an exact tag, which
    // is what this family wants an install to be made of. Renovate moves the
    // tag; nothing else can move it.
    //
    // Runtime dependencies, and they merge themselves anyway - the one place
    // this preset says so. What makes that safe is not that the change is
    // small; it is that the package's author wrote the size of it into the
    // commit subject, the package's own tests held it, and the consumer's
    // tests hold it again here, with the package built on the branch by its
    // own `prepare`. A group of its own rather than "runtime dependencies",
    // so that what the family tagged is one branch and what npm published is
    // another. No minimumReleaseAge: these are the family's own releases, and
    // the three days exist for a stranger's.
    {
      matchDatasources: ["github-tags"],
      matchPackageNames: ["Lautstark/**", "@lautstark/**"],
      matchUpdateTypes: ["patch", "minor"],
      groupName: "shared packages",
      commitMessageTopic: "the shared packages",
      automerge: true,
      automergeType: "branch",
      platformAutomerge: true,
      minimumReleaseAge: null,
      labels: ["dependencies", "shared", "automerge"],
    },

    // ---------------------------------------------------------------------
    // Everything else: grouped, and looked at by a person
    // ---------------------------------------------------------------------
    {
      matchDepTypes: ["dependencies"],
      matchUpdateTypes: ["patch", "minor"],
      groupName: "runtime dependencies",
      commitMessageTopic: "the runtime dependencies",
      automerge: false,
      labels: ["dependencies"],
    },

    {
      matchManagers: ["github-actions"],
      groupName: "GitHub Actions",
      automerge: false,
      labels: ["ci"],
      // A judgement call worth naming: these are CI tooling and look like dev
      // dependencies, but they are not devDependencies, and the rule is that
      // only devDependencies automerge. They also run with a token that can
      // write to the repository, which is a good reason for the stricter
      // reading rather than the convenient one. Flipping it is this one line.
    },

    // ---------------------------------------------------------------------
    // Majors are never grouped and never automerged
    // ---------------------------------------------------------------------
    {
      matchUpdateTypes: ["major"],
      groupName: null,
      automerge: false,
      labels: ["dependencies", "major"],
      // On its own, so that the one that breaks the build is obvious rather
      // than being one of nine changes in a pull request called "dev
      // dependencies".
    },

    // lockFileMaintenance is its own pull request, and is not automerged: it
    // can move transitive dependencies that no direct bump would have.
    {
      matchUpdateTypes: ["lockFileMaintenance"],
      automerge: false,
      labels: ["dependencies"],
    },
  ],
}
